[version]
signature="$Windows NT$"
Class=SCSIAdapter
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%QLOGIC%
CatalogFile=ql40xx.cat
DriverVer=08/29/2012,2.1.4.27

[SourceDisksNames]
1=%Floppy_Desc%,,,

[SourceDisksFiles]
ql40xx.sys=1
ql4x00pp.dll=1

[DestinationDirs]
DefaultDestDir = 12 ; DIRID_DRIVERS
ql4x00pp_File_Copy = 11

[Manufacturer]
%QLOGIC%=QLOGIC,NTamd64

;*******************************
;QLogic Manufacturer device list
[QLOGIC.NTamd64]
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4032&SUBSYS_01071077
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4032&SUBSYS_014F1077
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4032&SUBSYS_01581077
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4032&SUBSYS_036C1014
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4032&SUBSYS_036E1014
