%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4010&SUBSYS_02E01014
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4010&SUBSYS_02E21014

[ControlFlags]
ExcludeFromSelect = PCI\VEN_1077&DEV_4032&SUBSYS_01071077
ExcludeFromSelect = PCI\VEN_1077&DEV_4032&SUBSYS_014F1077
ExcludeFromSelect = PCI\VEN_1077&DEV_4032&SUBSYS_01581077
ExcludeFromSelect = PCI\VEN_1077&DEV_4032&SUBSYS_036C1014
ExcludeFromSelect = PCI\VEN_1077&DEV_4032&SUBSYS_036E1014
ExcludeFromSelect = PCI\VEN_1077&DEV_4032&SUBSYS_03721014
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_01221077
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_01241077
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_01281077
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_012E1077
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_02CF1014
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_02D01014
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_02E21014
ExcludeFromSelect = PCI\VEN_1077&DEV_4022&SUBSYS_03221014
ExcludeFromSelect = PCI\VEN_1077&DEV_4010&SUBSYS_01121077
ExcludeFromSelect = PCI\VEN_1077&DEV_4010&SUBSYS_01141077
ExcludeFromSelect = PCI\VEN_1077&DEV_4010&SUBSYS_011E1077
ExcludeFromSelect = PCI\VEN_1077&DEV_4010&SUBSYS_01201077
ExcludeFromSelect = PCI\VEN_1077&DEV_4010&SUBSYS_02CF1014
