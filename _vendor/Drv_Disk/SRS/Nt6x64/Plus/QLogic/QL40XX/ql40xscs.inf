%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4010&SUBSYS_01141077
%ql40xx.DeviceDesc% = ql40xx_Inst, PCI\VEN_1077&DEV_4010&SUBSYS_011E1077
