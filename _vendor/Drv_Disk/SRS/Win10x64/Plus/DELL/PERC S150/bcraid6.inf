; - Driver provided by Dell Inc. for Dell EMC PERC S150 6.3 software.
;
;-----------------------------------------------------------------------------

[Version]
Signature              = "$Windows NT$"
Provider               = %DELL%
Class                  = SCSIAdapter
ClassGUID              = {4D36E97B-E325-11CE-BFC1-08002BE10318}
CatalogFile            = bcraid6.cat
PnpLockDown            = 1
DriverVer              = 05/11/2022,6.3.1.0001

;-----------------------------------------------------------------------------

[SourceDisksNames]
1 = %bcraid_Desc%,,,""

;-----------------------------------------------------------------------------

[SourceDisksFiles]
bcraid631.sys = 1,,
bcraidf6.sys = 1,,
coinstaller6.dll = 1,,
bcupdate.exe = 1,,

;-----------------------------------------------------------------------------

[DestinationDirs]
DefaultDestDir = 12   ;%WinDir%\System32\Drivers directory on NT-based systems
CoInstaller_CopyFiles = 11

;-----------------------------------------------------------------------------

[ControlFlags]
ExcludeFromSelect = *

;-----------------------------------------------------------------------------

[Manufacturer]
%DELL% = DELL, ntamd64

;-----------------------------------------------------------------------------

[DELL.ntamd64]
;NVMe Controller/Drives

;Samsung Vendor and Device IDs for NVMe

;Samsung PM1725
%bcraid_Desc% = bcraid_Inst_VST_nvme, PCI\VEN_144D&DEV_A821&CC_010802

;Samsung PM1725a, PM1725b
%bcraid_Desc% = bcraid_Inst_VST_nvme, PCI\VEN_144D&DEV_A822&CC_010802

;Samsung PM1733, PM1735 
%bcraid_Desc% = bcraid_Inst_VST_nvme, PCI\VEN_144D&DEV_A824&CC_010802

;Samsung PM983  
