[Version]
Signature              = "$Windows NT$"
Provider               = %DELL%
Class                  = SCSIAdapter
ClassGUID              = {4D36E97B-E325-11CE-BFC1-08002BE10318}
CatalogFile            = bcraid5.cat
PnpLockDown            = 1
DriverVer              = 11/07/2020,5.5.4.0000

;-----------------------------------------------------------------------------

[SourceDisksNames]
1 = %bcraid_Desc%,,,""

;-----------------------------------------------------------------------------

[SourceDisksFiles]
bcraid554.sys = 1,,
bcraidf5.sys = 1,,
coinstaller5.dll = 1,,
bcupdate.exe = 1,,

;-----------------------------------------------------------------------------

[DestinationDirs]
DefaultDestDir = 12   ;%WinDir%\System32\Drivers directory on NT-based systems
CoInstaller_CopyFiles = 11

;-----------------------------------------------------------------------------

[ControlFlags]
ExcludeFromSelect = *

;-----------------------------------------------------------------------------

[Manufacturer]
%DELL% = DELL, ntamd64

;-----------------------------------------------------------------------------

[DELL.ntamd64]
