[Version] 
Signature="$Windows NT$" 
Provider=%MfgName% 
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318} 
Class=SCSIAdapter 
DriverVer=09/29/2014,3.2.5.0
CatalogFile=bfad.cat 
DriverPackageType=PlugAndPlay 
DriverPackageDisplayName=%PkgName% 
 
; 
; Source file information 
; 
 
[SourceDisksNames] 
1 = %DiskDesc%,,,"" 
 
[SourceDisksFiles] 
bfad.sys = 1,, 
bfad_up.sys  = 1,, 
bfad.dll = 1,, 
libdbfaj.dll = 1,, 
 
[SourceDisksFiles.amd64] 
bfad.sys = 1,, 
bfad_up.sys  = 1,, 
bfad.dll = 1,, 
libdbfaj.dll = 1,, 
libdbfaj32.dll = 1,, 
 
[DestinationDirs] 
; 
;[file-list-section=dirid[,subdir]] 
; 
DefaultDestDir   = 12	; %windir%\system32\drivers directory on NT-based systems 
bfadcocopy = 11 
bfaj32_CopyFiles = 10,"SysWow64" 
 
; 
; Driver information 
; 
 
[Manufacturer] 
; 
; The manufacturer-identifier for the HBA device. 
; 
%MfgName%   = BrcdModelsSection, NTx86.6.0, NTamd64.6.0, NTamd64.6.1,NTamd64.6.2 
 
[BrcdModelsSection.NTx86.6.0] 
%CrossbowFC.DeviceDesc% = BrcdUpperFilterInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_2PORT%&%CLASS_CODE% 
%Ct2FC.DeviceDesc% = BrcdCatapultInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC%&%CT2_FC_SUBSYS_ID% 
%Ct2FC4PORT.DeviceDesc% = BrcdCatapultInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC_4PORT%&%CT2_FC_SUBSYS_ID% 
%CatapultFC.DeviceDesc% = BrcdCatapultInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CT_FC%&%CLASS_CODE% 
%CrossbowFCfilter.DeviceDesc% = BrcdUpperFilterInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_1PORT%&%CLASS_CODE% 
%CrossbowFC.DeviceDesc% = BrcdUpperFilterInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_2PORT%&%SUBSYSTEM_ID% 
%CrossbowFCfilter.DeviceDesc% = BrcdUpperFilterInstallSection.NTx86.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_1PORT%&%SUBSYSTEM_ID% 
 
[BrcdModelsSection.NTamd64.6.0] 
%CrossbowFC.DeviceDesc% = BrcdUpperFilterInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_2PORT%&%CLASS_CODE% 
%Ct2FC.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC%&%CT2_FC_SUBSYS_ID% 
%Ct2FC4PORT.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC_4PORT%&%CT2_FC_SUBSYS_ID% 
%CatapultFC.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CT_FC%&%CLASS_CODE% 
%CrossbowFCfilter.DeviceDesc% = BrcdUpperFilterInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_1PORT%&%CLASS_CODE% 
%CrossbowFC.DeviceDesc% = BrcdUpperFilterInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_2PORT%&%SUBSYSTEM_ID% 
%CrossbowFCfilter.DeviceDesc% = BrcdUpperFilterInstallSection.NTamd64.6.0, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_1PORT%&%SUBSYSTEM_ID% 
 
[BrcdModelsSection.NTamd64.6.1] 
%CrossbowFC.DeviceDesc% = BrcdUpperFilterInstallSection.NTamd64.6.1, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_2PORT%&%CLASS_CODE% 
%Ct2FC.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.1, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC%&%CT2_FC_SUBSYS_ID% 
%Ct2FC4PORT.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.1, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC_4PORT%&%CT2_FC_SUBSYS_ID% 
%CatapultFC.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.1, PCI\%VENDOR_ID%&%DEVICE_ID_CT_FC%&%CLASS_CODE% 
