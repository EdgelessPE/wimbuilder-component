[BrcdModelsSection.NTamd64.6.2] 
%CrossbowFC.DeviceDesc% = BrcdUpperFilterInstallSection.NTamd64.6.2, PCI\%VENDOR_ID%&%DEVICE_ID_CBW_2PORT%&%CLASS_CODE% 
%Ct2FC.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.2, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC%&%CT2_FC_SUBSYS_ID% 
%Ct2FC4PORT.DeviceDesc% = BrcdCatapultInstallSection.NTamd64.6.2, PCI\%VENDOR_ID%&%DEVICE_ID_CT2_FC_4PORT%&%CT2_FC_SUBSYS_ID% 
