[HpCISSs3_Inst_V0.ntamd64]
CopyFiles = @HpCISSs3.sys

[HpCISSs3_Inst_V0.ntamd64.Services]
AddService = HpCISSs3, %SPSVCINST_ASSOCSERVICE%, HpCISSs3_Service_Inst, HpCISSs3_EventLog_Inst

[HpCISSs3_Inst_V1.ntamd64]
CopyFiles = @HpCISSs3.sys

[HpCISSs3_Inst_V1.ntamd64.Services]
AddService = HpCISSs3, %SPSVCINST_ASSOCSERVICE%, HpCISSs3_Service_Inst, HpCISSs3_EventLog_Inst

[HpCISSs3_Inst_V8.ntamd64]
CopyFiles = @HpCISSs3.sys

[HpCISSs3_Inst_V8.ntamd64.Services]
AddService = HpCISSs3, %SPSVCINST_ASSOCSERVICE%, HpCISSs3_Service_Inst, HpCISSs3_EventLog_Inst

[HpCISSs3_Inst_V16.ntamd64]
CopyFiles = @HpCISSs3.sys

[HpCISSs3_Inst_V16.ntamd64.Services]
AddService = HpCISSs3, %SPSVCINST_ASSOCSERVICE%, HpCISSs3_Service_Inst, HpCISSs3_EventLog_Inst

[HpCISSs3_Inst_V64.ntamd64]
CopyFiles = @HpCISSs3.sys

[HpCISSs3_Inst_V64.ntamd64.Services]
AddService = HpCISSs3, %SPSVCINST_ASSOCSERVICE%, HpCISSs3_Service_Inst, HpCISSs3_EventLog_Inst


[HpCISSs3_Service_Inst]
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %12%\HpCISSs3.sys
LoadOrderGroup = SCSI Miniport
AddReg         = pnpsafe_pci_addreg
AddReg         = IO_timeout_addreg

[HpCISSs3_EventLog_Inst]
AddReg = HpCISSs3_EventLog_AddReg

[HpCISSs3_EventLog_AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll;%%SystemRoot%%\System32\drivers\HpCISSs3.sys"
HKR,,TypesSupported,%REG_DWORD%,7

[pnpsafe_pci_addreg]
HKR, ,                          "Tag",                        %REG_DWORD%,  0x103
HKR, "Parameters\PnpInterface", "5",                          %REG_DWORD%,  0x00000001
HKR, "Parameters\Device",       "DriverParameter",            %REG_SZ%,     "CSMI=None;"
HKR, "Parameters",              "BusType",                    %REG_DWORD%,  0x0000000A
HKR, "Parameters\Drive",        "EnableQueryAccessAlignment", %REG_DWORD%,  0x00000001

[IO_timeout_addreg]
HKR, "System\CurrentControlSet\Services\HpCISSs3\Parameters", "IoTimeoutValue", %REG_DWORD%, 0x0000003C


[HpCISSs3_Inst_V0.ntamd64.HW]
Include=machine.inf
Needs=PciIoSpaceNotRequired, PciASPMOptOut
AddReg=SupportStorportIPM_addreg
AddReg=AdditionalSenseData_addreg
AddReg=EnableFull64Bit_addreg

[HpCISSs3_Inst_V1.ntamd64.HW]
AddReg=MsiSupport_addreg
Include=machine.inf
Needs=PciIoSpaceNotRequired, PciASPMOptOut
AddReg=SupportStorportIPM_addreg
AddReg=AdditionalSenseData_addreg
AddReg=EnableFull64Bit_addreg

[HpCISSs3_Inst_V8.ntamd64.HW]
AddReg=Msi8Support_addreg
Include=machine.inf
Needs=PciIoSpaceNotRequired, PciASPMOptOut
AddReg=SupportStorportIPM_addreg
AddReg=AdditionalSenseData_addreg
AddReg=EnableFull64Bit_addreg

[HpCISSs3_Inst_V16.ntamd64.HW]
AddReg=Msi16Support_addreg
Include=machine.inf
Needs=PciIoSpaceNotRequired, PciASPMOptOut
AddReg=SupportStorportIPM_addreg
AddReg=AdditionalSenseData_addreg
AddReg=EnableFull64Bit_addreg

[HpCISSs3_Inst_V64.ntamd64.HW]
AddReg=Msi64Support_addreg
Include=machine.inf
Needs=PciIoSpaceNotRequired, PciASPMOptOut
AddReg=SupportStorportIPM_addreg
AddReg=AdditionalSenseData_addreg
AddReg=EnableFull64Bit_addreg

[MsiSupport_addreg]
HKR, Interrupt Management, %CREATE_KEYONLY%
HKR, "Interrupt Management\MessageSignaledInterruptProperties", %CREATE_KEYONLY%
;Set to a nonzero value to enable MSI or MSI-x support.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MSISupported", %REG_DWORD%, 0x00000001
;Max number of MSI or MSI-X vectors a driver can manage from one device.
;Used to limit the number of vectors to fewer than those requested by the controller.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MessageNumberLimit", %REG_DWORD%, 0x0000001
HKR, "Interrupt Management\Affinity Policy", "DevicePolicy", %REG_DWORD%, 0x01
HKR, "Interrupt Management\Affinity Policy", "GroupPolicy", %REG_DWORD%, 0x01

[Msi8Support_addreg]
HKR, Interrupt Management, %CREATE_KEYONLY%
HKR, "Interrupt Management\MessageSignaledInterruptProperties", %CREATE_KEYONLY%
;Set to a nonzero value to enable MSI or MSI-x support.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MSISupported", %REG_DWORD%, 0x00000001
;Max number of MSI or MSI-X vectors a driver can manage from one device.
;Used to limit the number of vectors to fewer than those requested by the controller.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MessageNumberLimit", %REG_DWORD%, 0x0000008
HKR, "Interrupt Management\Affinity Policy", "DevicePolicy", %REG_DWORD%, 0x01
HKR, "Interrupt Management\Affinity Policy", "GroupPolicy", %REG_DWORD%, 0x01

[Msi16Support_addreg]
HKR, Interrupt Management, %CREATE_KEYONLY%
HKR, "Interrupt Management\MessageSignaledInterruptProperties", %CREATE_KEYONLY%
;Set to a nonzero value to enable MSI or MSI-x support.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MSISupported", %REG_DWORD%, 0x00000001
;Max number of MSI or MSI-X vectors a driver can manage from one device.
;Used to limit the number of vectors to fewer than those requested by the controller.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MessageNumberLimit", %REG_DWORD%, 0x0000010
HKR, "Interrupt Management\Affinity Policy", "DevicePolicy", %REG_DWORD%, 0x01
HKR, "Interrupt Management\Affinity Policy", "GroupPolicy", %REG_DWORD%, 0x01

[Msi64Support_addreg]
HKR, Interrupt Management, %CREATE_KEYONLY%
HKR, "Interrupt Management\MessageSignaledInterruptProperties", %CREATE_KEYONLY%
;Set to a nonzero value to enable MSI or MSI-x support.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MSISupported", %REG_DWORD%, 0x00000001
;Max number of MSI or MSI-X vectors a driver can manage from one device.
;Used to limit the number of vectors to fewer than those requested by the controller.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MessageNumberLimit", %REG_DWORD%, 0x0000040
HKR, "Interrupt Management\Affinity Policy", "DevicePolicy", %REG_DWORD%, 0x05
HKR, "Interrupt Management\Affinity Policy", "GroupPolicy", %REG_DWORD%, 0x01

[SupportStorportIPM_addreg]
; Enables Storport IPM for this adapter
HKR, "StorPort", "EnableIdlePowerManagement", %REG_DWORD%, 0x01

[AdditionalSenseData_addreg]
; Sense data size not to exceed 40 bytes for driver versions < 6.22.
HKR, "StorPort", "TotalSenseDataBytes", %REG_DWORD%, 0x28

[EnableFull64Bit_addreg]
; Instruct driver to use 64 bit addressing through storport if supported on this machine.
HKLM, "System\CurrentControlSet\Services\HpCISSs3\Parameters\Device", "EnableFull64Bit", %REG_BINARY%,  0x1


