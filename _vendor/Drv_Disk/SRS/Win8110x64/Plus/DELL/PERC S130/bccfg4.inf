;-----------------------------------------------------------------------------

;
; bccfg4.inf = Installation for Dell PERC S130 Configuration Device
;

; Copyright (c) 2002-2008 Ciprico Inc.  All rights reserved.

; Copyright (c) 2008-2011 Dot Hill Systems Corp.  All rights reserved.

; Copyright (c) 2012-2015 Dell Inc.  All rights reserved.

;
;-----------------------------------------------------------------------------

;- This version supports Windows XP and later operating systems.

; - Class and ClassGUID specify the type of driver and must match

;     (see $DDKPATH/inc/api/devguid.h).

; - Driver provided by Dell Inc. for PERC S130 4.2 software.

;   (4.2.0.0009)

;-----------------------------------------------------------------------------



;-----------------------------------------------------------------------------

[Version]

Signature = "$Windows NT$"

Class = System

ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}

Provider = %DELL%

CatalogFile.ntamd64 = bcraid4.cat

DriverVer = 12/24/2015,4.2.0.0009

PnpLockDown = 1

;-----------------------------------------------------------------------------

[SourceDisksNames]
1 = %bccfg_Desc%


;-----------------------------------------------------------------------------

[SourceDisksFiles]
bccfg4.sys = 1


;-----------------------------------------------------------------------------

[DestinationDirs]

DefaultDestDir = 12   ;%WinDir%\System32\Drivers directory on NT-based systems


;-----------------------------------------------------------------------------

[ControlFlags]

ExcludeFromSelect = *


;-----------------------------------------------------------------------------

[Manufacturer]

%DELL% = DELL,ntamd64


;-----------------------------------------------------------------------------

[DELL.ntamd64]

%bccfg_Desc% = bccfg_Inst, SCSI\ProcessorRAIDCOREConfiguration___V1.1


;-----------------------------------------------------------------------------

[bccfg_Inst]

CopyFiles = DefaultDestDir

;-----------------------------------------------------------------------------

[DefaultDestDir]

bccfg4.sys,,,0x00002004


;-----------------------------------------------------------------------------

[bccfg_Inst.Services]

AddService = bccfg4,0x00000002,bccfg_Service_Inst


;-----------------------------------------------------------------------------

[bccfg_Service_Inst]

ServiceType   = 1                    ; SERVICE_KERNEL_DRIVER

StartType     = 3                    ; SERVICE_DEMAND_START

ErrorControl  = 1                    ; SERVICE_ERROR_NORMAL

ServiceBinary = %12%\bccfg4.sys

DisplayName   = %bccfg_Desc%


;-----------------------------------------------------------------------------

[Strings]
DELL = "Dell Inc."

bccfg_Desc = "Dell PERC S130 Configuration Device"

